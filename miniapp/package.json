{
  "name": "miniapp",
  "private": true,
  "version": "1.0.0",
  "description": "Telegram Mini App для игр бота: каркас M2 (универсальный рендер экранов сервера)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",

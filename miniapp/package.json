    "preact": "^10.26.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@preact/preset-vite": "^2.10.0",
    "@testing-library/preact": "^3.2.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
